{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "KycSessionContext",
    "type": "object",
    "properties": {
        "session_id": {
            "type": "string",
            "format": "uuid"
        },
        "raw_inputs": {
            "type": "object"
        },
        "extracted_identity_fields": {
            "type": "object"
        },
        "risk_assessment": {
            "type": "object"
        },
        "processing_timestamps": {
            "type": "object"
        }
